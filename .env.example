# Copie este archivo como .env para desarrollo local. En Railway configure estas
# variables en la pestaña "Variables" del servicio.

ENTORNO=desarrollo
LOG_LEVEL=INFO
CORS_ORIGINS=*

# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}  (referencia al plugin PostgreSQL)
# Si se deja vacío/ausente se usa SQLite local (lyra.db)
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/lyra

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
# Voice ID: Voice Library -> filtrar Spanish / acento Mexican / female -> "Add" -> copiar ID
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_SPEED=0.9

AUDIO_CACHE_MAX_MB=300
